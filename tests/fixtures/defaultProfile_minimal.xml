<profile version="0">
  <priorities>
    <priority name="pure_include" value="0"/>
    <priority name="default" value="1"/>
    <priority name="minigames" value="5"/>
    <priority name="cutscenes" value="10"/>
    <priority name="menu" value="11"/>
    <priority name="overlays" value="12"/>
  </priorities>

  <actionmap name="open_menu" priority="pure_include" exclusivity="0">
    <action name="open_menu" onPress="1" onRelease="1" keyboard="_keybinds_ref_" noModifiers="1" xboxpad="xi_start" pspad="pad_start"/>
  </actionmap>

  <actionmap name="open_pause_menu" priority="pure_include" exclusivity="0">
    <action name="open_pause_menu" onPress="1" onRelease="1" keyboard="_keybinds_ref_" noModifiers="1" xboxpad="xi_start" pspad="pad_start"/>
  </actionmap>

  <actionmap name="player" priority="default" exclusivity="0">
    <include actionmap="open_menu" />
  </actionmap>

  <actionmap name="dialog" priority="minigames" exclusivity="1">
    <include actionmap="open_pause_menu" />
    <action name="dialog_cancel" onPress="1" onRelease="1" xboxpad="xi_b" />
  </actionmap>

  <actionmap name="cutscene" priority="cutscenes" exclusivity="1">
    <include actionmap="open_pause_menu" />
    <action name="cutscene_skip" onPress="1" onRelease="1" xboxpad="xi_b" />
  </actionmap>

  <actionfilter name="no_pause_test" type="actionFail">
    <action name="open_pause_menu" />
  </actionfilter>
  <actionfilter name="pause_pass_test" type="actionPass">
    <action name="open_pause_menu" />
  </actionfilter>
</profile>
